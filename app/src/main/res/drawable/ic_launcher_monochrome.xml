<?xml version="1.0" encoding="utf-8"?>
<!--
    Themed-icon layer (Android 13+). The system reads only the alpha channel here and
    tints it with the user's wallpaper palette, so the mark is drawn flat — no cyan,
    no bloom. Same geometry as the foreground so the silhouette stays identical.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M41,30 L78,30 L78,67 L67,78 L30,78 L30,41 Z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5"
        android:strokeLineJoin="miter"
        android:fillColor="#00000000" />

    <path
        android:pathData="M43.4,55 L51.1,64.6 L64.6,43.4"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="square"
        android:strokeLineJoin="miter"
        android:fillColor="#00000000" />
</vector>
