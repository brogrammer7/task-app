<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon background: the unlit ground, with the mark's bloom baked in.

    The glow lives here rather than as rings around the foreground mark because a
    circular launcher mask crops anything beyond a 36-unit radius from centre — a
    background layer always fills the mask, so the falloff never shows a cut edge.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- VoidNavy, matching the app background exactly. -->
    <path
        android:fillColor="#070B14"
        android:pathData="M0,0h108v108h-108z" />

    <!-- Cyan bloom behind the mark. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="38">
                <item
                    android:offset="0.0"
                    android:color="#593DF5FF" />
                <item
                    android:offset="0.45"
                    android:color="#263DF5FF" />
                <item
                    android:offset="1.0"
                    android:color="#003DF5FF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
