<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Dark base with an explicit window background. Without this the app flashes a
        white frame between launch and the first Compose frame, which is jarring
        against a near-black UI.
    -->
    <style name="Theme.TaskApp" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/void_navy</item>
    </style>
</resources>
